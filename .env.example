# ==========================================
# SOFI AI ENVIRONMENT CONFIGURATION
# ==========================================

# PRIMARY ROUTER: Unified API key for https://agentrouter.org
# Unlocks: Claude Opus 4.8, Claude Opus 5, DeepSeek v4 Flash, GLM 5.3, GPT-5.6 Sol, Claude 3.5 Sonnet, GPT-4o
AGENTROUTER_API_KEY=""

# DIRECT API KEYS (Optional fallbacks)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# GEMINI_API_KEY: Optional
GEMINI_API_KEY=""

# LOCAL LLM (Qwen 2.5 / Ollama on AWS EC2)
# Run 100% locally on CPU: ollama run qwen2.5:0.5b (or qwen2.5:1.5b)
LOCAL_OLLAMA_URL="http://127.0.0.1:11434"
LOCAL_OLLAMA_MODEL="qwen2.5:0.5b"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SOFI ADMIN CREDENTIALS: For /sofiadmin control portal & SSH terminal
SOFI_ADMIN_USER="admin"
SOFI_ADMIN_PASSWORD="sofi_aws_2026"

# SMTP EMAIL VERIFICATION CREDENTIALS (Optional)
# Used to send email verification codes for new user registrations
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Sofi AI\" <noreply@sofi.ai>"

